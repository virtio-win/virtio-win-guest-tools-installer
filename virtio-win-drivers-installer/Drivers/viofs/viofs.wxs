<?xml version='1.0' encoding='UTF-8'?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
<?include ../../constants.wxi ?>
<?include ./viofs.wxi ?>

    <Fragment>
        <ComponentGroup Id="CMPG_$(var.driverName)_driver" Directory="$(var.destDirName)">
        <?if $(sys.BUILDARCH) = "x64" ?>
            <ComponentGroupRef Id='CMPG_WinServer2016_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_WinServer2019_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_WinServer2022_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_WinServer2025_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_Win10x64_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_Win11x64_$(var.driverName)' />
        <?else ?>
            <ComponentGroupRef Id='CMPG_Win10x86_$(var.driverName)' />
        <?endif ?>
            <Component Id="CMP_viofs_driver_Registry"
                Guid='*'>
                <RegistryValue Id="Registry_FileSystemName"
                    KeyPath="yes"
                    Action="write"
                    Root="HKLM"
                    Key="Software\VirtIO-FS"
                    Name="FileSystemName"
                    Value="NTFS"
                    Type="string" />
            </Component>
        </ComponentGroup>

        <!-- ServiceInstall resets VirtioFsSvc to demand start on upgrade and repair; keep an existing
             automatic, delayed automatic or disabled start type. AppSearch runs before the old service is touched. -->
        <Property Id="VIOFSSVC_START" Secure="yes">
            <RegistrySearch Id="VirtioFsSvcStartSearch" Root="HKLM"
                Key="SYSTEM\CurrentControlSet\Services\VirtioFsSvc" Name="Start" Type="raw" />
        </Property>
        <Property Id="VIOFSSVC_DELAYED" Secure="yes">
            <RegistrySearch Id="VirtioFsSvcDelayedSearch" Root="HKLM"
                Key="SYSTEM\CurrentControlSet\Services\VirtioFsSvc" Name="DelayedAutostart" Type="raw" />
        </Property>
        <CustomAction Id="CA_SetVirtioFsSvcAuto" Property="CA_RestoreVirtioFsSvcStart"
            Value='"[SystemFolder]sc.exe" config VirtioFsSvc start= auto' />
        <CustomAction Id="CA_SetVirtioFsSvcDelayed" Property="CA_RestoreVirtioFsSvcStart"
            Value='"[SystemFolder]sc.exe" config VirtioFsSvc start= delayed-auto' />
        <CustomAction Id="CA_SetVirtioFsSvcDisabled" Property="CA_RestoreVirtioFsSvcStart"
            Value='"[SystemFolder]sc.exe" config VirtioFsSvc start= disabled' />
        <CustomAction Id="CA_RestoreVirtioFsSvcStart" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
            DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />
        <InstallExecuteSequence>
            <Custom Action="CA_SetVirtioFsSvcAuto" Before="CA_RestoreVirtioFsSvcStart"
                Condition='VIOFSSVC_START="#2" AND VIOFSSVC_DELAYED&lt;&gt;"#1"' />
            <Custom Action="CA_SetVirtioFsSvcDelayed" Before="CA_RestoreVirtioFsSvcStart"
                Condition='VIOFSSVC_START="#2" AND VIOFSSVC_DELAYED="#1"' />
            <Custom Action="CA_SetVirtioFsSvcDisabled" Before="CA_RestoreVirtioFsSvcStart"
                Condition='VIOFSSVC_START="#4"' />
            <Custom Action="CA_RestoreVirtioFsSvcStart" After="InstallServices"
                Condition='CA_RestoreVirtioFsSvcStart AND (&amp;FE_viofs_driver=3 OR (!FE_viofs_driver=3 AND &amp;FE_viofs_driver&lt;&gt;2))' />
        </InstallExecuteSequence>
    </Fragment>
</Wix>
