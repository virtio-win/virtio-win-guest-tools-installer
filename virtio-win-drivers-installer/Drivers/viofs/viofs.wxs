<?xml version='1.0' encoding='UTF-8'?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
<?include ../../constants.wxi ?>
<?include ./viofs.wxi ?>

    <Fragment>
        <ComponentGroup Id="CMPG_$(var.driverName)_driver" Directory="$(var.destDirName)">
        <?if $(sys.BUILDARCH) = "x64" ?>
            <ComponentGroupRef Id='CMPG_WinServer2016_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_WinServer2019_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_WinServer2022_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_WinServer2025_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_Win10x64_$(var.driverName)' />
            <ComponentGroupRef Id='CMPG_Win11x64_$(var.driverName)' />
        <?else ?>
            <ComponentGroupRef Id='CMPG_Win10x86_$(var.driverName)' />
        <?endif ?>
            <Component Id="CMP_viofs_driver_Registry"
                Guid='*'>
                <RegistryValue Id="Registry_FileSystemName"
                    KeyPath="yes"
                    Action="write"
                    Root="HKLM"
                    Key="Software\VirtIO-FS"
                    Name="FileSystemName"
                    Value="NTFS"
                    Type="string" />
            </Component>
        </ComponentGroup>
        <Property Id="VIOFS_SERVICE_NAME" Value="VirtioFsSvc" Secure="yes" />
        <Property Id="VIOFS_LEGACY_SERVICE" Secure="yes">
            <RegistrySearch Id="ViofsLegacyServiceSearch" Root="HKLM"
                Key="SYSTEM\CurrentControlSet\Services\VirtIO-FS Service" Name="ImagePath" Type="raw" />
        </Property>
        <Property Id="VIOFS_CURRENT_SERVICE" Secure="yes">
            <RegistrySearch Id="ViofsCurrentServiceSearch" Root="HKLM"
                Key="SYSTEM\CurrentControlSet\Services\VirtioFsSvc" Name="ImagePath" Type="raw" />
        </Property>
        <SetProperty Id="VIOFS_SERVICE_NAME" Value="VirtIO-FS Service" Before="CostFinalize" Sequence="execute"
            Condition="VIOFS_LEGACY_SERVICE AND NOT VIOFS_CURRENT_SERVICE" />
        <Launch Condition='VIOFS_SERVICE_NAME="VirtioFsSvc" OR VIOFS_SERVICE_NAME="VirtIO-FS Service"'
            Message="Unsupported Virtio-FS service name." />
    </Fragment>
</Wix>
