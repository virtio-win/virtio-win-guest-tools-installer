<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI for the arm64 build of qemu-ga (see .github/workflows/build-qemu-ga-arm64.yml).

  Not a copy of QEMU's own qga/installer/qemu-ga.wxs: that template assumes a
  GCC-mingw toolchain (libgcc_s_seh-1.dll, libwinpthread-1.dll, libssp-0.dll,
  iconv.dll). This build uses llvm-mingw/clang against UCRT instead - no GCC
  runtime DLLs are linked at all (confirmed via strings on the built exe:
  only libglib-2.0-0.dll plus Windows-provided kernel32/advapi32/
  api-ms-win-crt-* imports). VSS support is enabled: qga-vss.dll is C++
  (unlike qemu-ga.exe itself, plain C), so it needs clang's own C++ runtime
  - libc++.dll and libunwind.dll - rather than GCC's libstdc++-6.dll that
  QEMU's template bundles. The RegisterCom/UnRegisterCom custom actions
  below are copied verbatim from QEMU's own template though: that's just
  how MSI-driven COM self-registration works, independent of toolchain.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Name="QEMU Guest Agent (arm64)"
    Id="*"
    UpgradeCode="{6F1B6E8B-6E27-4A9E-9C2E-2C6E7E9B7B2A}"
    Manufacturer="$(var.QEMU_GA_MANUFACTURER)"
    Version="$(var.QEMU_GA_VERSION)"
    Language="1033">

    <Package
      Manufacturer="$(var.QEMU_GA_MANUFACTURER)"
      InstallerVersion="500"
      Languages="1033"
      Compressed="yes"
      InstallScope="perMachine"
      />
    <Media Id="1" Cabinet="qemu_ga.$(var.QEMU_GA_VERSION).cab" EmbedCab="yes" />

    <!-- msiexec installs fine on any 64-bit Windows regardless of CPU
         family, but the service itself is a native ARM64 binary that
         can't execute on x64 hardware - block that mismatch up front with
         a clear message rather than a silently-broken service. Same
         PROCESSOR_ARCHITECTURE registry technique as
         virtio-win-drivers-installer/properties.wxs, for the same reason:
         VersionNT64 alone is true on both x64 and arm64 Windows. -->
    <Property Id="REGISTRY_PROCESSOR_ARCHITECTURE" Secure="yes">
      <RegistrySearch Id="ProcessorArchitectureSearch"
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
          Name="PROCESSOR_ARCHITECTURE"
          Type="raw" />
    </Property>
    <Condition Message="This is the arm64 build of QEMU Guest Agent; it will not run on this processor architecture.">
      <![CDATA[Installed OR (VersionNT64 AND REGISTRY_PROCESSOR_ARCHITECTURE = "ARM64")]]>
    </Condition>

    <Property Id="ARPNOMODIFY" Value="yes" Secure="yes" />
    <MajorUpgrade
      DowngradeErrorMessage="Error: A newer version of QEMU Guest Agent (arm64) is already installed."
      />
    <Property Id="rundll" Value="rundll32.exe"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="qemu_ga_directory" Name="Qemu-ga">
          <Component Id="qemu_ga" Guid="{80F83D1B-8C98-4187-A5D6-B8B674DE4457}">
            <File Id="qemu_ga.exe" Name="qemu-ga.exe" Source="$(var.BIN_DIR)/qemu-ga.exe" KeyPath="yes" DiskId="1"/>
            <ServiceInstall
              Id="ServiceInstaller"
              Type="ownProcess"
              Vital="yes"
              Name="QEMU-GA"
              DisplayName="QEMU Guest Agent"
              Description="QEMU Guest Agent"
              Start="auto"
              Account="LocalSystem"
              ErrorControl="ignore"
              Interactive="no"
              Arguments="-d --retry-path"
              >
            </ServiceInstall>
            <ServiceControl Id="StartService" Start="install" Stop="both" Remove="uninstall" Name="QEMU-GA" Wait="yes" />
          </Component>
          <Component Id="gspawn_helper_console" Guid="{D64B0BCA-FE9E-4DE6-B1B5-ABA8EEC6E81B}">
            <File Id="gspawn_win64_helper_console.exe" Name="gspawn-win64-helper-console.exe" Source="$(var.BIN_DIR)/gspawn-win64-helper-console.exe" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="gspawn_helper" Guid="{4D2C7711-44F2-460B-9DCC-7A12B5606631}">
            <File Id="gspawn_win64_helper.exe" Name="gspawn-win64-helper.exe" Source="$(var.BIN_DIR)/gspawn-win64-helper.exe" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libglib" Guid="{EC510F8D-4875-4EC1-AEAB-39BC15EAA0C9}">
            <File Id="libglib_2.0_0.dll" Name="libglib-2.0-0.dll" Source="$(var.BIN_DIR)/libglib-2.0-0.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libpcre2" Guid="{75B056B9-6FFC-4502-84A8-A872CDF2C5B2}">
            <File Id="libpcre2_8_0.dll" Name="libpcre2-8-0.dll" Source="$(var.BIN_DIR)/libpcre2-8-0.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="zlib" Guid="{2EEE3C7E-967E-4FEC-82C8-F445C56BDB29}">
            <File Id="zlib1.dll" Name="zlib1.dll" Source="$(var.BIN_DIR)/zlib1.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libffi" Guid="{A8E59BBE-AB7A-4636-807E-CF99D0F17ED7}">
            <File Id="libffi_8.dll" Name="libffi-8.dll" Source="$(var.BIN_DIR)/libffi-8.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libintl" Guid="{A2DF7C01-5DBD-49F7-B4BC-FF8BC8A73641}">
            <File Id="libintl_8.dll" Name="libintl-8.dll" Source="$(var.BIN_DIR)/libintl-8.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libiconv" Guid="{EE079CD5-802B-46B9-BDA7-95B30E878BA7}">
            <File Id="libiconv_2.dll" Name="libiconv-2.dll" Source="$(var.BIN_DIR)/libiconv-2.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libcharset" Guid="{837DEB54-B132-4B4A-997F-C0D27875BEAC}">
            <File Id="libcharset_1.dll" Name="libcharset-1.dll" Source="$(var.BIN_DIR)/libcharset-1.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libcxx" Guid="{E68BA740-9DDA-452D-8F25-E88C38203C6C}">
            <File Id="libcxx.dll" Name="libc++.dll" Source="$(var.BIN_DIR)/libc++.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="libunwind" Guid="{5FF35C88-06CC-4D49-B8AF-8094C0975890}">
            <File Id="libunwind_1.dll" Name="libunwind.dll" Source="$(var.BIN_DIR)/libunwind.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="qga_vss_dll" Guid="{8A365F07-6A18-4D8C-AEE6-3D80C670CEC4}">
            <File Id="qga_vss.dll" Name="qga-vss.dll" Source="$(var.BIN_DIR)/qga-vss.dll" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="qga_vss_tlb" Guid="{C78C29D7-9AFA-4C8D-AC90-10F25BABB15A}">
            <File Id="qga_vss.tlb" Name="qga-vss.tlb" Source="$(var.BIN_DIR)/qga-vss.tlb" KeyPath="yes" DiskId="1"/>
          </Component>
          <Component Id="registry_entries" Guid="{1EA3374E-4A89-41C2-A15F-E810FF95398C}">
            <RegistryKey Root="HKLM"
                         Key="Software\$(var.QEMU_GA_MANUFACTURER)\$(var.QEMU_GA_DISTRO)\Tools\QemuGA">
              <RegistryValue Type="string" Name="ProductID" Value="fb0a0d66-c7fb-4e2e-a16b-c4a3bfe8d13b" KeyPath="yes" />
              <RegistryValue Type="string" Name="Version" Value="$(var.QEMU_GA_VERSION)" />
            </RegistryKey>
            <RegistryKey Root="HKLM"
                         Key="System\CurrentControlSet\Services\EventLog\Application\qemu-ga">
              <RegistryValue Type="integer" Name="TypesSupported" Value="7" />
              <RegistryValue Type="string" Name="EventMessageFile" Value="[qemu_ga_directory]qemu-ga.exe" />
            </RegistryKey>
            <RegistryKey Root="HKLM"
                         Key="System\CurrentControlSet\Services\QEMU Guest Agent VSS Provider">
              <RegistryValue Type="integer" Name="VssOption" Value="1" />
            </RegistryKey>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <!-- Verbatim from QEMU's own qga/installer/qemu-ga.wxs: this is just how
         MSI-driven COM self-registration for a VSS provider works, nothing
         toolchain-specific about it. -->
    <CustomAction Id="RegisterCom"
              ExeCommand='"[qemu_ga_directory]qga-vss.dll",DLLCOMRegister'
              Execute="deferred"
              Property="rundll"
              Impersonate="no"
              Return="check"
              >
    </CustomAction>
    <CustomAction Id="UnRegisterCom"
              ExeCommand='"[qemu_ga_directory]qga-vss.dll",DLLCOMUnregister'
              Execute="deferred"
              Property="rundll"
              Impersonate="no"
              Return="check"
              >
    </CustomAction>
    <CustomAction Id="UnRegisterCom_Rollback"
              ExeCommand='"[qemu_ga_directory]qga-vss.dll",DLLCOMUnregister'
              Execute="rollback"
              Property="rundll"
              Impersonate="no"
              Return="check"
              >
    </CustomAction>

    <Feature Id="QemuGA" Title="QEMU Guest Agent" Level="1">
      <ComponentRef Id="qemu_ga" />
      <ComponentRef Id="gspawn_helper_console" />
      <ComponentRef Id="gspawn_helper" />
      <ComponentRef Id="libglib" />
      <ComponentRef Id="libpcre2" />
      <ComponentRef Id="zlib" />
      <ComponentRef Id="libffi" />
      <ComponentRef Id="libintl" />
      <ComponentRef Id="libiconv" />
      <ComponentRef Id="libcharset" />
      <ComponentRef Id="libcxx" />
      <ComponentRef Id="libunwind" />
      <ComponentRef Id="qga_vss_dll" />
      <ComponentRef Id="qga_vss_tlb" />
      <ComponentRef Id="registry_entries" />
    </Feature>

    <InstallExecuteSequence>
      <!-- Explicit Sequence numbers to place UnRegisterCom_Rollback right
           before RegisterCom and after InstallFiles, matching QEMU's own
           template comment: WiX doesn't order this correctly from
           After=/Before= attributes alone here. -->
      <Custom Action="UnRegisterCom_Rollback" Sequence="5849">NOT REMOVE</Custom>
      <Custom Action="RegisterCom" Sequence="5850">NOT REMOVE</Custom>
      <Custom Action="UnRegisterCom" Sequence="1901">Installed</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
