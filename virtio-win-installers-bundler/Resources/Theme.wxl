  <String Id="QgaVssUnavailable" Value="VSS cannot be installed while SENS is disabled or unreadable. Uncheck VSS to continue with the Agent only." />
  <String Id="QgaVssFullDependency" Value="The installed VSS component needs SENS for repair or removal. Enable SENS before continuing; this bundle will not change its policy." />
