  <String Id="ConfirmCancelMessage" Value="Are you sure you want to cancel?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Previous version" />
  <String Id="HelpHeader" Value="Setup Help" />
  <String Id="HelpText" Value="/install (default) | /modify | /repair | /uninstall&#xA;/layout [directory]: complete local copy.&#xA;/passive | /quiet: minimal or no UI, without prompts.&#xA;/norestart: suppress restart. /log log.txt: log file (default %TEMP%).&#xA;&#xA;QgaVssEnabled=0: Agent-only; =1: full; =-1: retain installed variant; fresh install: full (no Agent-only fallback).&#xA;Upgrades/Repair retain the variant; Modify alone switches it.&#xA;Full install/repair/removal needs readable, non-disabled SENS, COMSysApp and their configured dependencies." />
  <String Id="HelpCloseButton" Value="&amp;Close" />
  <String Id="InstallAcceptCheckbox" Value="I &amp;agree to the license terms and conditions" />
