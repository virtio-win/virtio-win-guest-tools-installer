<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="0" Height="-12" Weight="500" Foreground="000000" Background="FFFFFF">Segoe UI</Font>
    <Font Id="1" Height="-24" Weight="500" Foreground="000000">Segoe UI</Font>
    <Font Id="2" Height="-22" Weight="500" Foreground="666666">Segoe UI</Font>
    <Font Id="3" Height="-12" Weight="500" Foreground="000000" Background="FFFFFF">Segoe UI</Font>
    <Font Id="4" Height="-12" Weight="500" Foreground="ff0000" Background="FFFFFF" Underline="yes">Segoe UI</Font>
    <!-- side bar pic -->
    <Image Id="Logo" ImageFile="Logo.png"/>
    <Window Width="500" Height="380" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)">
        <ImageControl ImageId="Logo" X="0" Y="0" Width="150" Height="320" Visible="yes"/>
        <!--
          WiXStdBA 6.0.2 runs Detect for the Help command instead of keeping the
          Help page selected. Keep the Help controls outside the page so they
          remain visible throughout that state transition.
        -->
        <Label X="175" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes" VisibleCondition="WixBundleCommandLineAction = 1">#(loc.HelpHeader)</Label>
        <Label X="175" Y="130" Width="-11" Height="-35" FontId="3" DisablePrefix="yes" VisibleCondition="WixBundleCommandLineAction = 1">#(loc.HelpText)</Label>
        <Button Name="HelpCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" VisibleCondition="WixBundleCommandLineAction = 1">
            <Text>#(loc.HelpCloseButton)</Text>
            <CloseWindowAction />
        </Button>
        <Page Name="Loading">
            <Label Name="CheckingForUpdatesLabel" X="175" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes" Visible="no" />
        </Page>
        <Page Name="Help">
            <!-- The visible Help controls are window-level; keep the page registered with WiXStdBA. -->
            <Label X="0" Y="0" Width="1" Height="1" FontId="0" Visible="no" />
        </Page>
        <Page Name="Install">
            <Label X="175" Y="10" Width="300" Height="80" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.WelcomeTitle)</Label>
            <Richedit Name="EulaRichedit" X="175" Y="100" Width="300" Height="-100" TabStop="yes" FontId="0" HexStyle="0x800000" />
            <Checkbox Name="EulaAcceptCheckbox" X="175" Y="-70" Width="300" Height="20" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
            <Button Name="InstallButton" X="-100" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
            <Button Name="InstallCancelButton" X="-10" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Progress">
            <Label X="175" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label X="175" Y="130" Width="70" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
            <Label Name="OverallProgressPackageText" X="245" Y="130" Width="-11" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="175" Y="160" Width="-11" Height="15" />
            <Button Name="ProgressCancelButton" X="-10" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>
        <Page Name="Modify">
            <Label X="175" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Button Name="RepairButton" X="-190" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-100" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-10" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Success">
            <Label X="175" Y="80" Width="-11" Height="80" FontId="2" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
            </Label>
            <Label X="175" Y="165" Width="-11" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.SuccessRestartText)</Label>
            <Button Name="SuccessRestartButton" X="-100" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-10" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Failure">
            <Label X="175" Y="40" Width="-11" Height="80" FontId="2" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="175" Y="125" Width="-11" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="175" Y="170" Width="-11" Height="100" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="175" Y="-51" Width="-11" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-100" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-10" Y="-10" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
