<?xml version="1.0" encoding="UTF-8"?>
<?define UpgradeCode = "{418D4443-48DC-4FCF-BA11-29D5E241B7D1}" ?>
<?include $(var.QgaPackageMetadataPath) ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
    Name="Virtio-win-guest-tools"
    Version="$(var.Version)"
    Manufacturer="Red Hat, Inc."
    UpgradeCode="$(var.UpgradeCode)"
    IconSourceFile="Resources/icon.ico">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="rtfLicense"
        LicenseFile="Resources/License.rtf"
        LogoFile="Resources/Logo.png"
        ThemeFile="Resources/Theme.xml"
        LocalizationFile="Resources/Theme.wxl"/>
      <Payload SourceFile="$(var.QgaBAFunctionsPath)" bal:BAFunctions="yes" />
    </BootstrapperApplication>

    <!-- Raw CLI request, UI choice, validated plan and pending operation are separate. -->
    <Variable Name="QgaVssEnabled" Type="numeric" Value="-1" bal:Overridable="yes" />
    <Variable Name="QgaVssTarget" Type="numeric" Value="1" />
    <Variable Name="QgaVssEffective" Type="numeric" Value="1" />
    <Variable Name="QgaCanModify" Type="numeric" Value="0" />
    <Variable Name="QgaResumeAllowed" Type="numeric" Value="0" />
    <Variable Name="QgaLifecycleError" Type="string" Value="" />
    <Variable Name="QgaFullFamily" Type="string" Value="$(var.QgaFullUpgradeCode)" />
    <Variable Name="QgaNoVssFamily" Type="string" Value="$(var.QgaNoVssUpgradeCode)" />
    <Variable Name="QgaPendingKind" Type="numeric" Value="0" Persisted="yes" />
    <Variable Name="QgaPendingSource" Type="numeric" Value="-1" Persisted="yes" />
    <Variable Name="QgaPendingTarget" Type="numeric" Value="-1" Persisted="yes" />
    <Variable Name="SensStart" Type="numeric" Value="-1" />
    <Variable Name="QgaServicePresent" Type="numeric" Value="0" />
    <Variable Name="QgaFullState" Type="numeric" Value="2" />
    <Variable Name="QgaNoVssState" Type="numeric" Value="2" />
    <Variable Name="QgaFullVersion" Type="version" Value="0.0.0" />
    <Variable Name="QgaNoVssVersion" Type="version" Value="0.0.0" />
    <Variable Name="QgaPayloadVersion" Type="version" Value="0.0.0" />
    <Variable Name="QgaFullInstalled" Type="numeric" Value="0" />
    <Variable Name="QgaNoVssInstalled" Type="numeric" Value="0" />
    <SetVariable Id="ResetSensStart" Variable="SensStart" Type="numeric" Value="-1" />
    <util:RegistrySearch Id="FindSensStart" Variable="SensStart" Root="HKLM"
        Key="SYSTEM\CurrentControlSet\Services\SENS" Value="Start" Result="value" Bitness="always32" After="ResetSensStart" />
    <!-- State 5 is installed; state 2 is absent. Registration survives a missing service or key file. -->
    <util:ProductSearch Id="FindQgaFull" Variable="QgaFullState"
        UpgradeCode="$(var.QgaFullUpgradeCode)" Result="state" After="FindSensStart" />
    <SetVariable Id="ResetQgaFullVersion" Variable="QgaFullVersion" Type="version" Value="0.0.0" After="FindQgaFull" />
    <util:ProductSearch Id="FindQgaFullVersion" Variable="QgaFullVersion"
        UpgradeCode="$(var.QgaFullUpgradeCode)" Result="version" Condition="QgaFullState = 5" After="ResetQgaFullVersion" />
    <util:ProductSearch Id="FindQgaNoVss" Variable="QgaNoVssState"
        UpgradeCode="$(var.QgaNoVssUpgradeCode)" Result="state" After="FindQgaFullVersion" />
    <SetVariable Id="ResetQgaNoVssVersion" Variable="QgaNoVssVersion" Type="version" Value="0.0.0" After="FindQgaNoVss" />
    <util:ProductSearch Id="FindQgaNoVssVersion" Variable="QgaNoVssVersion"
        UpgradeCode="$(var.QgaNoVssUpgradeCode)" Result="version" Condition="QgaNoVssState = 5" After="ResetQgaNoVssVersion" />
    <SetVariable Id="SelectQga64Version" Variable="QgaPayloadVersion" Type="version" Value="$(var.Qga64Version)"
        Condition="VersionNT64" After="FindQgaNoVssVersion" />
    <SetVariable Id="SelectQga86Version" Variable="QgaPayloadVersion" Type="version" Value="$(var.Qga86Version)"
        Condition="NOT VersionNT64" After="SelectQga64Version" />
    <util:RegistrySearch Id="FindQgaService" Variable="QgaServicePresent" Root="HKLM"
        Key="SYSTEM\CurrentControlSet\Services\QEMU-GA" Value="ImagePath" Result="exists"
        Bitness="always32" After="SelectQga86Version" />
    <SetVariable Id="ResetQgaFull" Variable="QgaFullInstalled" Type="numeric" Value="0" After="FindQgaService" />
    <SetVariable Id="DetectQgaFull" Variable="QgaFullInstalled" Type="numeric" Value="1"
        After="ResetQgaFull" Condition="QgaFullState = 5" />
    <SetVariable Id="ResetQgaNoVss" Variable="QgaNoVssInstalled" Type="numeric" Value="0" After="DetectQgaFull" />
    <SetVariable Id="DetectQgaNoVss" Variable="QgaNoVssInstalled" Type="numeric" Value="1"
        After="ResetQgaNoVss" Condition="QgaNoVssState = 5" />

    <bal:Condition
        Condition="NOT (WixBundleCommandLineAction = 4 OR WixBundleCommandLineAction = 6 OR WixBundleCommandLineAction = 7 OR WixBundleCommandLineAction = 8) OR QgaResumeAllowed = 1 OR NOT (QgaFullInstalled = 1 AND QgaNoVssInstalled = 1)"
        Message="Both QGA variants are installed. Resolve the conflicting installations before using this experimental bundle." />
    <bal:Condition
        Condition="NOT (WixBundleCommandLineAction = 4 OR WixBundleCommandLineAction = 6 OR WixBundleCommandLineAction = 7 OR WixBundleCommandLineAction = 8) OR ((QgaFullState = 2 OR QgaFullState = 5) AND (QgaNoVssState = 2 OR QgaNoVssState = 5) AND (QgaServicePresent = 0 OR QgaFullInstalled = 1 OR QgaNoVssInstalled = 1))"
        Message="This experimental bundle cannot identify the existing QGA installation. Use its original installer to remove it before continuing." />
    <bal:Condition
        Condition="NOT (WixBundleCommandLineAction = 6 OR WixBundleCommandLineAction = 7 OR WixBundleCommandLineAction = 8) OR QgaVssEnabled = -1 OR QgaVssEnabled = 0 OR QgaVssEnabled = 1"
        Message="QgaVssEnabled must be -1 (automatic), 0 (Agent only), or 1 (Agent with VSS)." />
    <!-- Native planning rejects conflicting upgrade/Repair requests, including full UI. -->
    <bal:Condition
        Condition="NOT (WixBundleCommandLineAction = 6 OR WixBundleCommandLineAction = 7 OR WixBundleCommandLineAction = 8) OR (QgaFullVersion &lt;= QgaPayloadVersion AND QgaNoVssVersion &lt;= QgaPayloadVersion)"
        Message="A newer QGA version is installed. Use an installer with matching or newer QGA payloads to upgrade or repair it." />
    <!-- The native plan callback revalidates SENS after the UI target is chosen. -->
    <bal:Condition Condition="NOT QgaLifecycleError" Message="[QgaLifecycleError]" />
    <bal:Condition
        Condition="WixBundleCommandLineAction &lt;&gt; 4 OR QgaFullInstalled = 0 OR (SensStart &gt;= 0 AND SensStart &lt; 4)"
        Message="Removing the installed QGA VSS component requires SENS. Enable SENS before uninstalling; this bundle will not change the service policy." />

    <Chain>
      <MsiPackage
         SourceFile="$(var.VirtioWinGtX64MsiPath)"
         InstallCondition="VersionNT64"
         EnableFeatureSelection="yes"
         bal:DisplayInternalUICondition="WixBundleAction = 6"
         DisplayName="virtio-win-drivers"
         Description="MSI to install virtio-win drivers for x64 systems"/>
      <MsiPackage
         SourceFile="$(var.VirtioWinGtX86MsiPath)"
         InstallCondition="NOT VersionNT64"
         EnableFeatureSelection="yes"
         bal:DisplayInternalUICondition="WixBundleAction = 6"
         DisplayName="virtio-win-drivers"
         Description="MSI to install virtio-win drivers for x86 systems"/>
      <MsiPackage SourceFile="$(var.SpiceDriver64MsiPath)"
         InstallCondition="VersionNT64 AND VersionNT64 &gt; v8"
         DisplayName="spice-driver"/>
      <MsiPackage SourceFile="$(var.SpiceDriver86MsiPath)"
         InstallCondition="NOT VersionNT64 AND VersionNT &gt; v8"
         DisplayName="spice-driver"/>
      <MsiPackage SourceFile="$(var.SpiceVdagent64MsiPath)"
         InstallCondition="VersionNT64"
         DisplayName="spice-guest-agent"/>
      <MsiPackage SourceFile="$(var.SpiceVdagent86MsiPath)"
         InstallCondition="NOT VersionNT64"
         DisplayName="spice-guest-agent"/>
      <MsiPackage Id="QgaFull64" SourceFile="$(var.QemuGa64MsiPath)"
         InstallCondition="VersionNT64 AND QgaVssEffective = 1"
         DisplayName="qemu-guest-agent (with VSS)"/>
      <MsiPackage Id="QgaFull86" SourceFile="$(var.QemuGa86MsiPath)"
         InstallCondition="NOT VersionNT64 AND QgaVssEffective = 1"
         DisplayName="qemu-guest-agent (with VSS)"/>
      <MsiPackage Id="QgaNoVss64" SourceFile="$(var.QemuGaNoVss64MsiPath)"
         InstallCondition="VersionNT64 AND QgaVssEffective = 0"
         DisplayName="qemu-guest-agent (no VSS)"/>
      <MsiPackage Id="QgaNoVss86" SourceFile="$(var.QemuGaNoVss86MsiPath)"
         InstallCondition="NOT VersionNT64 AND QgaVssEffective = 0"
         DisplayName="qemu-guest-agent (no VSS)"/>
    </Chain>
  </Bundle>
</Wix>
